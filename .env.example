# TikTok Clip Automation
# Copiá este archivo como .env y completá tus datos.

KICK_CHANNEL=tu_canal
KICK_POLL_SECONDS=1
KICK_ERROR_BACKOFF_SECONDS=5

CLIPS_DIR=data/clips
OUTPUT_DIR=data/reels
USED_DIR=data/used
DIVIDER_PATH=assets/divider.png
FONT_PATH="assets/TF2 build.ttf"
CLIP_REGISTRY_FILE=data/seen_clips.json

NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_TRIM_OMNI=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TRIM_OMNI_TIMEOUT=180

FACE_MAX_RETRIES_KIMI=5
FACE_KIMI_MODEL=moonshotai/kimi-k3
FACE_FALLBACK_MODEL=google/diffusiongemma-26b-a4b-it
FACE_KIMI_TIMEOUT=130
FACE_FALLBACK_TIMEOUT=60

WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE=default
WHISPER_BACKEND=auto
WHISPER_CPP_EXE=tools/whisper.cpp/whisper-cli.exe
WHISPER_CPP_MODEL=tools/whisper.cpp/models/ggml-large-v3.bin
WHISPER_CPP_THREADS=8

TIKTOK_COOKIES_FILE=data/tiktok_cookies.txt
TIKTOK_HEADLESS=true
TIKTOK_AUTO_UPLOAD=true
TIKTOK_UPLOAD_START_HOUR=11
TIKTOK_UPLOAD_END_HOUR=21
TIKTOK_MAX_PER_DAY=10
TIKTOK_VARIATION_MINUTES=5
TIKTOK_UPLOAD_CHECK_SECONDS=30
TIKTOK_CAPTION_TEMPLATE="{title} #tiktok #kick"
TIKTOK_UPLOAD_REGISTRY=data/tiktok_uploads.json
